<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found - Learning Website</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/animations.css">
    <!-- Add Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .error-container {
            text-align: center;
            padding: 3rem 0;
            animation: fadeIn 0.8s ease-in-out;
        }
        
        .error-icon {
            font-size: 5rem;
            color: var(--primary-color);
            margin-bottom: 1.5rem;
            animation: pulse 2s infinite;
        }
        
        .error-code {
            font-size: 3.5rem;
            font-weight: bold;
            color: var(--primary-color);
            margin-bottom: 1rem;
        }
        
        .error-message {
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            color: var(--text-color);
        }
        
        .error-description {
            max-width: 600px;
            margin: 0 auto 2rem;
            color: var(--text-light);
            font-size: 1.1rem;
        }
        
        .back-link {
            margin-top: 2rem;
            display: flex;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
        }
        
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }
        
        .btn:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
        }
        
        .navigation-help {
            margin-top: 3rem;
            background-color: var(--light-gray);
            padding: 1.5rem;
            border-radius: var(--border-radius-lg);
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            animation: fadeInUp 0.8s ease-out;
        }
        
        .navigation-help h3 {
            margin-bottom: 1rem;
            color: var(--text-color);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .navigation-links {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            text-align: left;
        }
        
        .nav-link-item {
            padding: 0.8rem;
            background-color: white;
            border-radius: var(--border-radius-md);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            text-decoration: none;
            color: var(--primary-color);
        }
        
        .nav-link-item:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            background-color: var(--light-gray);
        }
        
        .nav-link-item i {
            margin-right: 0.8rem;
            font-size: 1.2rem;
        }
        
        header {
            animation: slideInFromTop 0.8s ease-out;
        }
        
        footer {
            margin-top: 3rem;
            text-align: center;
            padding: 1.5rem;
            background-color: var(--light-gray);
            border-radius: var(--border-radius-md);
            animation: fadeIn 1s ease-in-out;
        }
        
        .search-box {
            max-width: 500px;
            margin: 2rem auto;
            animation: fadeInUp 0.8s ease-out;
        }
        
        .search-box form {
            display: flex;
            gap: 0.5rem;
        }
        
        .search-box input {
            flex-grow: 1;
            padding: 0.8rem;
            border: 2px solid var(--medium-gray);
            border-radius: var(--border-radius-md);
            font-size: 1rem;
            transition: all 0.3s ease;
        }
        
        .search-box input:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
        }
        
        .search-box button {
            padding: 0.8rem 1.5rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="slide-from-top">
            <h1><i class="fas fa-graduation-cap"></i> Learning Website</h1>
        </header>
        <main>
            <div class="error-container">
                <div class="error-icon">
                    <i class="fas fa-map-signs"></i>
                </div>
                
                <div class="error-code">404</div>
                <div class="error-message">Page Not Found</div>
                
                <div class="error-description">
                    <p>The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>
                    <% if (typeof requestedUrl !== 'undefined') { %>
                        <p><strong>Requested URL:</strong> <%= requestedUrl %></p>
                    <% } %>
                </div>
                
                <div class="search-box">
                    <form action="/search" method="GET">
                        <input type="text" name="q" placeholder="Search for learning resources...">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
                    </form>
                </div>
                
                <div class="back-link">
                    <a href="/" class="btn btn-primary"><i class="fas fa-home"></i> Back to Home</a>
                    <% if (user) { %>
                        <a href="/home" class="btn btn-primary"><i class="fas fa-tachometer-alt"></i> Go to Dashboard</a>
                    <% } else { %>
                        <a href="/login" class="btn btn-primary"><i class="fas fa-sign-in-alt"></i> Log In</a>
                        <a href="/signup" class="btn btn-primary"><i class="fas fa-user-plus"></i> Sign Up</a>
                    <% } %>
                    <button onclick="window.history.back()" class="btn btn-primary"><i class="fas fa-arrow-left"></i> Go Back</button>
                </div>
                
                <div class="navigation-help">
                    <h3><i class="fas fa-compass"></i> Popular Destinations</h3>
                    <div class="navigation-links">
                        <a href="/" class="nav-link-item">
                            <i class="fas fa-home"></i> Home
                        </a>
                        <% if (user) { %>
                            <a href="/home" class="nav-link-item">
                                <i class="fas fa-tachometer-alt"></i> Dashboard
                            </a>
                            <a href="/daily-topics" class="nav-link-item">
                                <i class="fas fa-calendar-day"></i> Daily Topics
                            </a>
                            <a href="/ai-recommendations" class="nav-link-item">
                                <i class="fas fa-robot"></i> AI Recommendations
                            </a>
                        <% } else { %>
                            <a href="/login" class="nav-link-item">
                                <i class="fas fa-sign-in-alt"></i> Log In
                            </a>
                            <a href="/signup" class="nav-link-item">
                                <i class="fas fa-user-plus"></i> Sign Up
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>
        </main>
        <footer>
            <p>&copy; 2025 Learning Website | <i class="fas fa-code"></i> with <i class="fas fa-heart" style="color: #333;"></i></p>
        </footer>
    </div>
</body>
</html> 